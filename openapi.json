{
  "openapi": "3.1.0",
  "info": {
    "title": "Huerise Daylight Alarm API",
    "description": "Run one YAML-configured Philips Hue daylight alarm.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/doctor": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Doctor",
        "operationId": "doctor_doctor_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/rooms": {
      "get": {
        "tags": [
          "lighting"
        ],
        "summary": "Rooms",
        "operationId": "rooms_rooms_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RoomResponse"
                  },
                  "type": "array",
                  "title": "Response Rooms Rooms Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/rooms/{room_id}/scenes/{scene_id}/demo": {
      "post": {
        "tags": [
          "lighting"
        ],
        "summary": "Demo",
        "operationId": "demo_rooms__room_id__scenes__scene_id__demo_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "room_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Room Id"
            }
          },
          {
            "name": "scene_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Scene Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "lighting"
        ],
        "summary": "Stop Demo",
        "operationId": "stop_demo_rooms__room_id__scenes__scene_id__demo_delete",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "room_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Room Id"
            }
          },
          {
            "name": "scene_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Scene Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/hue/bridges": {
      "get": {
        "tags": [
          "hue-setup"
        ],
        "summary": "Discover Bridges",
        "operationId": "discover_bridges_hue_bridges_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BridgeResponse"
                  },
                  "type": "array",
                  "title": "Response Discover Bridges Hue Bridges Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/hue/bridge": {
      "get": {
        "tags": [
          "hue-setup"
        ],
        "summary": "Bridge Status",
        "operationId": "bridge_status_hue_bridge_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      },
      "put": {
        "tags": [
          "hue-setup"
        ],
        "summary": "Select Bridge",
        "operationId": "select_bridge_hue_bridge_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BridgeSelectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/hue/bridge/register": {
      "post": {
        "tags": [
          "hue-setup"
        ],
        "summary": "Register Bridge",
        "operationId": "register_bridge_hue_bridge_register_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/daylight-alarm/start": {
      "post": {
        "tags": [
          "daylight-alarm"
        ],
        "summary": "Start",
        "operationId": "start_daylight_alarm_start_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/daylight-alarm/stop": {
      "post": {
        "tags": [
          "daylight-alarm"
        ],
        "summary": "Stop",
        "operationId": "stop_daylight_alarm_stop_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AlarmStatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AlarmStatusResponse"
      },
      "BridgeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "ip_address": {
            "type": "string",
            "title": "Ip Address"
          },
          "selected": {
            "type": "boolean",
            "title": "Selected"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ip_address",
          "selected"
        ],
        "title": "BridgeResponse"
      },
      "BridgeSelectionRequest": {
        "properties": {
          "bridge_id": {
            "type": "string",
            "minLength": 1,
            "title": "Bridge Id"
          }
        },
        "type": "object",
        "required": [
          "bridge_id"
        ],
        "title": "BridgeSelectionRequest"
      },
      "DemoResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "started",
            "title": "Status",
            "default": "started"
          },
          "duration_seconds": {
            "type": "integer",
            "const": 10,
            "title": "Duration Seconds",
            "default": 10
          }
        },
        "type": "object",
        "title": "DemoResponse"
      },
      "DoctorCheckResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "DoctorCheckResponse"
      },
      "DoctorResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DoctorCheckResponse"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "DoctorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "OnboardingState": {
        "type": "string",
        "enum": [
          "not_selected",
          "link_button_required",
          "ready"
        ],
        "title": "OnboardingState"
      },
      "OnboardingStatusResponse": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/OnboardingState"
          },
          "bridge_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bridge Id"
          },
          "ip_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "read_only": {
            "type": "boolean",
            "title": "Read Only"
          }
        },
        "type": "object",
        "required": [
          "state",
          "bridge_id",
          "ip_address",
          "read_only"
        ],
        "title": "OnboardingStatusResponse"
      },
      "RoomResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "scenes": {
            "items": {
              "$ref": "#/components/schemas/SceneResponse"
            },
            "type": "array",
            "title": "Scenes"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "scenes"
        ],
        "title": "RoomResponse"
      },
      "SceneResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "SceneResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}

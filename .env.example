AUTH_JWT_SECRET=change-me-to-a-long-random-secret
# Optional CLI overrides (the CLI otherwise logs in via `huerise auth login` and localhost:8000)
# HUERISE_API_URL=http://localhost:8000
HUE_APP_KEY=your-hue-app-key
HUE_BRIDGE_IP=your-hue-bridge-ip
DATABASE_URL=postgresql+asyncpg://huerise:huerise@localhost:5432/huerise
# Credentials for the postgres container in compose.yml
POSTGRES_USER=huerise
POSTGRES_PASSWORD=huerise
POSTGRES_DB=huerise
